+    @contextmanager
+    def window(self):
+        self.access()
+        _issued_require(self.stage_frame is None and self.stage_index < 8, "capacity_denied")
+        self.stage_index += 1
+        self.stage_frame = self.stage_anchor = self.entry
+        try:
+            self.checkpoint()
+            yield
+            self.checkpoint()
+        finally:
+            self.stage_frame = self.stage_anchor = None
